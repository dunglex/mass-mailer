{{define "layout-head"}}
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap');
:root{--ink:#17211b;--paper:#f7f3e9;--green:#21694f;--yellow:#e0b52b;--line:#c9c3b5;--muted:#69736d;--red:#9c3d35}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px 'DM Mono',monospace}header{padding:28px max(24px,calc((100% - 1120px)/2));border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}h1,h2,h3{font-family:Fraunces,serif;margin:0}h1{font-size:38px}header p{margin:5px 0 0;color:var(--muted)}main{max-width:1120px;margin:0 auto;padding:30px 24px 56px}.topline{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:24px}.actions{display:flex;gap:8px;flex-wrap:wrap}a.button,button{display:inline-block;border:0;border-radius:3px;background:var(--green);color:#fff;font:inherit;padding:10px 14px;cursor:pointer;text-decoration:none}a.button.alt,button.alt{background:var(--yellow);color:var(--ink)}button.danger{background:var(--red)}.flash{background:#e4f0d9;border-left:5px solid var(--green);padding:13px 16px;margin-bottom:24px}.batch{border-top:2px solid var(--ink);padding:18px 0;display:grid;grid-template-columns:1fr auto;gap:16px}.batch h3{font-size:22px}.meta,.hint{color:var(--muted);font-size:12px;line-height:1.7}.empty{border:1px dashed var(--line);padding:22px;color:var(--muted)}.form{max-width:720px;border-top:3px solid var(--ink);padding-top:12px}label{display:block;margin:14px 0 5px;font-size:12px;color:var(--muted);text-transform:uppercase}input,textarea,select{width:100%;border:1px solid var(--line);border-radius:2px;background:#fffdf7;padding:10px;font:inherit;color:var(--ink)}textarea{resize:vertical;min-height:90px}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.log{width:100%;border-collapse:collapse;margin-top:20px}.log th,.log td{text-align:left;padding:10px 6px;border-bottom:1px solid var(--line);font-size:12px;vertical-align:top}.status-sent{color:var(--green)}.status-failed{color:var(--red)}@media(max-width:650px){header{align-items:start;flex-direction:column}.topline,.batch{align-items:start;flex-direction:column;grid-template-columns:1fr}.row{grid-template-columns:1fr}.log{display:block;overflow-x:auto;white-space:nowrap}}
</style>
{{end}}