{{define "index"}}<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mass Mailer</title>{{template "layout-head" .}}</head><body><header><div><h1>Mass Mailer</h1><p>Batch delivery, on your schedule.</p></div><span>LOCAL MAIL OPS</span></header><main>{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}<div class="topline"><h2>Batches</h2><div class="actions"><a class="button alt" href="/settings">Server settings</a><a class="button" href="/batches/new">New batch</a></div></div>{{range .Store.Batches}}<article class="batch"><div><h3><a href="/batches/{{.ID}}">{{.Name}}</a></h3><p class="meta">{{len .Receivers}} receivers · From {{.SenderEmail}} · {{if .Schedule}}{{.Schedule}}{{else}}Manual{{end}}{{if .LastSentAt}} · Last sent {{.LastSentAt.Format "2006-01-02 15:04"}}{{end}}</p></div><a class="button alt" href="/batches/{{.ID}}">Open</a></article>{{else}}<p class="empty">No batches yet. Create one to begin sending.</p>{{end}}</main></body></html>{{end}}