# Copy to .env and adjust. Compose loads .env automatically.
#
# As shipped, this file is configured for local testing against the bundled
# Mailpit sink:
#
#   cp .env.example .env
#   docker compose --profile dev up --build
#
# The app comes up already pointed at Mailpit, so you can create a batch and
# hit "Send test" without visiting the Server settings page first. Captured
# mail is at http://localhost:8025.

# Host port to publish the web UI on. The container always listens on 8080.
PORT=8080

# Credentials for HTTP Basic Auth on the web UI.
# These protect the Mass Mailer interface itself -- they are NOT the SMTP
# credentials below.
# Leave both empty to run with NO authentication (a warning is logged at boot).
AUTH_USER=admin
AUTH_PASSWORD=change-me

# --- SMTP -------------------------------------------------------------------
# Seeds the Server settings page ONLY when no settings have been saved yet.
# Anything saved from the web interface persists to ./data and wins afterwards;
# delete data/mass-mailer.json to fall back to these values again.
#
# "mailpit" is the compose service name, reachable from the app container on
# the default network. Encryption must be "none" for Mailpit -- it listens in
# plaintext. Use "tls" (STARTTLS) or "ssl" for a real provider.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=none

