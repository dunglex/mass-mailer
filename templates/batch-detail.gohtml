{{define "batch-detail"}}<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Batch.Name}} · Mass Mailer</title>{{template "layout-head" .}}</head><body><header><div><h1>Mass Mailer</h1><p>Batch detail and delivery history.</p></div><a class="button alt" href="/">Back to batches</a></header><main>{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}<div class="topline"><div><h2>{{.Batch.Name}}</h2><p class="meta">{{len .Batch.Receivers}} receivers · From {{.Batch.SenderName}} &lt;{{.Batch.SenderEmail}}&gt;<br>Schedule: {{if .Batch.Schedule}}{{.Batch.Schedule}}{{else}}Manual{{end}}</p></div><div class="actions"><form method="post" action="/batches/{{.Batch.ID}}/send"><button>Send now</button></form><form method="post" action="/batches/{{.Batch.ID}}/delete"><button class="danger">Delete</button></form></div></div><section class="form"><h3>Send test</h3><form class="actions" method="post" action="/batches/{{.Batch.ID}}/test"><input type="email" name="test_email" placeholder="test@example.com" required><button class="alt">Send test</button></form></section><section><div class="topline"><h3>Delivery log</h3><span class="meta">{{len .Batch.Logs}} entries</span></div>{{if .Batch.Logs}}<table class="log"><thead><tr><th>Time</th><th>Type</th><th>Recipient</th><th>Status</th><th>Message</th></tr></thead><tbody>{{range .Batch.Logs}}<tr><td>{{.At.Format "2006-01-02 15:04:05"}}</td><td>{{.Kind}}</td><td>{{.Recipient}}</td><td class="status-{{if eq .Status "Sent"}}sent{{else}}failed{{end}}">{{.Status}}</td><td>{{.Message}}</td></tr>{{end}}</tbody></table>{{else}}<p class="empty">No deliveries have been attempted for this batch.</p>{{end}}</section></main></body></html>{{end}}