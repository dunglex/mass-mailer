{{define "settings"}}<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Server settings · Mass Mailer</title>{{template "layout-head" .}}</head><body><header><div><h1>Mass Mailer</h1><p>SMTP server configuration.</p></div><a class="button alt" href="/">Back to batches</a></header><main>{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}<div class="topline"><h2>Server settings</h2></div><form class="form" method="post" action="/settings"><label>SMTP host</label><input name="host" value="{{.Store.Settings.Host}}" placeholder="smtp.example.com" required><label>Port</label><input name="port" type="number" value="{{.Store.Settings.Port}}" placeholder="587" required><label>Username</label><input name="username" value="{{.Store.Settings.Username}}"><label>Password</label><input name="password" type="password" value="{{.Store.Settings.Password}}"><label>Encryption</label><select name="encryption"><option value="tls">STARTTLS</option><option value="ssl" {{if eq .Store.Settings.Encryption "ssl"}}selected{{end}}>SSL/TLS</option><option value="none" {{if eq .Store.Settings.Encryption "none"}}selected{{end}}>None</option></select><p class="actions"><button>Save server</button></p></form></main></body></html>{{end}}