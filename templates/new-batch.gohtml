{{define "new-batch"}}<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>New batch · Mass Mailer</title>{{template "layout-head" .}}</head><body><header><div><h1>Mass Mailer</h1><p>Create a delivery batch.</p></div><a class="button alt" href="/">Back to batches</a></header><main>{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}<div class="topline"><h2>New batch</h2></div><form class="form" method="post" action="/batches"><label>Start from a template</label><select id="email-template"><option value="">Blank email</option>{{range .Templates}}<option data-subject="{{.Subject}}" data-body="{{.Body}}">{{.Name}}</option>{{end}}</select><p class="hint">Selecting a template replaces the subject and email body. Both remain editable.</p><label>Batch name</label><input name="name" placeholder="October update" required><label>Sender name and email</label><div class="row"><input name="sender_name" placeholder="Team Mass Mailer"><input type="email" name="sender_email" placeholder="hello@example.com" required></div><label>Subject</label><input id="subject" name="subject" placeholder="Hello &#123;&#123;name&#125;&#125;" required><label>HTML email template</label><textarea id="body" name="body" rows="7" placeholder="&lt;h1&gt;Hello &#123;&#123;name&#125;&#125;&lt;/h1&gt;&lt;p&gt;Your message here.&lt;/p&gt;"></textarea><label>Receivers (CSV)</label><textarea name="receivers" placeholder="name,email,phone&#10;Ada Lovelace,ada@example.com,+15550100" required></textarea><p class="hint">CSV headers are available as placeholders, such as &#123;&#123;name&#125;&#125; and &#123;&#123;phone&#125;&#125;.</p><label>Attachment paths (one per line)</label><textarea name="attachments" rows="2" placeholder="C:\\mail-assets\\guide.pdf"></textarea><label>Schedule (optional cron)</label><input name="schedule" placeholder="0 9 * * 1-5"><p class="hint">Five fields: minute hour day-of-month month day-of-week.</p><p class="actions"><button>Create batch</button></p></form><script>document.getElementById("email-template").addEventListener("change",function(){var option=this.options[this.selectedIndex];document.getElementById("subject").value=option.dataset.subject||"";document.getElementById("body").value=option.dataset.body||"";});</script></main></body></html>{{end}}